  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@getpaseo/client": "^0.16.1",
    "@getpaseo/plugin": "^0.16.1",
    "@getpaseo/protocol": "^0.16.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
