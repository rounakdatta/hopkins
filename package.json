{
  "name": "paseo-hopkins",
  "version": "0.3.2",
  "description": "Reminders, check-ins and timed tasks that come back at the right moment in one Paseo conversation you can reply to.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "files": [
    "paseo-plugin.json",
    "index.server.ts",
    "index.client.tsx",
    "server/",
    "client/",
    "shared/",
    "README.md",
    "LICENSE",
    "OVERVIEW.md",
    "assets/"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
